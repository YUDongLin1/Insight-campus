# 校园情报官 Insight Campus 环境变量示例
# 复制本文件为 .env 后填写真实密钥：cp .env.example .env

PORT=3001
APP_TIMEZONE=Asia/Shanghai

# auto: 有密钥则调用腾讯云，无密钥则 Mock；force: 强制 Mock，路演时更稳定
MOCK_MODE=auto

# 腾讯云访问密钥，必须只放在后端 .env，绝不能写进 index.html
TENCENT_SECRET_ID=your_tencent_secret_id
TENCENT_SECRET_KEY=your_tencent_secret_key
TENCENT_REGION=ap-guangzhou

# 混元模型。腾讯云文档示例值包含 hunyuan-turbos-latest；也可改成账号已开通的模型。
HUNYUAN_MODEL=hunyuan-turbos-latest

# 智谱 BigModel：用于上传海报/截图时的多模态识别，也可在前端 AI 控制台填写。
BIGMODEL_API_KEY=your_bigmodel_api_key
BIGMODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4
BIGMODEL_MODEL=glm-4.7
BIGMODEL_VISION_MODEL=glm-4.5v
